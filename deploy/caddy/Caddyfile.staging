{
	email gaotao@gaotao.cc
	admin 127.0.0.1:2019
}

(common_security) {
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}
}

# Tunnel staging configuration: identical routes to the production Caddyfile but
# served with Caddy's internal local CA so the HTTPS flow (forward_auth, 2FA,
# Secure/HttpOnly/SameSite cookies) can be validated over the SSH tunnel without
# any public 80/443 or a public ACME challenge. Not for public production use.
auth.gaotao.cc {
	tls internal
	import common_security
	reverse_proxy 127.0.0.1:9091
}

dsh.gaotao.cc {
	tls internal
	import common_security

	@internal path /internal/*
	respond @internal 404
	@webhook path /hooks/clouddrive2
	handle @webhook {
		route {
			request_header X-Webhook-Secret {query.key}
			rewrite * {path}
			reverse_proxy 127.0.0.1:3080
		}
	}

	handle {
		forward_auth 127.0.0.1:9091 {
			uri /api/authz/forward-auth
			copy_headers Remote-User Remote-Groups Remote-Name Remote-Email
		}
		reverse_proxy 127.0.0.1:3080 {
			header_down Set-Cookie (.*) "$1; Secure"
		}
	}
}

emby.gaotao.cc {
	tls internal
	import common_security
	reverse_proxy 127.0.0.1:8096
}
