{
	admin 127.0.0.1:2019
}

# Self-use HTTP mode (no TLS, no ACME, no Authelia forward_auth gate).
# The http:// scheme forces Caddy to serve plain HTTP (no automatic HTTPS).
# The webhook bridge (query key -> X-Webhook-Secret header) is preserved so
# CloudDrive events still reach the DSH host. /internal/* stays 404.
# For the operator's own use over the loopback/tunnel; not public-facing.

# `dsh.gaotao.cc` is intentionally not a DSH entrypoint. Reserve the
# authority explicitly so a future DNS/port-forward change fails closed.
http://dsh.gaotao.cc {
	respond 404
}

# NPS maps gaotao.cc:3080/8096/19798 to Debian port 80. Preserve the
# original Host header so one Caddy listener can route each external port while
# DSH, Emby, and CloudDrive stay loopback-only.
http://gaotao.cc {
	@dsh header Host gaotao.cc:3080
	handle @dsh {
		@internal path /internal/*
		respond @internal 404

		@login path /login /logout
		handle @login {
			reverse_proxy 127.0.0.1:9092 {
				header_up -X-Forwarded-For
				header_up X-Real-IP {http.request.remote.host}
			}
		}

		handle {
			forward_auth 127.0.0.1:9092 {
				uri /auth/check
				copy_headers Remote-User
			}
			header {
				Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
				Referrer-Policy no-referrer
				X-Content-Type-Options nosniff
				X-Frame-Options DENY
			}
			reverse_proxy 127.0.0.1:3080 {
				header_up Host dsh.gaotao.cc
				header_up Origin http://dsh.gaotao.cc
				header_up Cookie {$DSH_UPSTREAM_COOKIE}
			}
		}
	}

	@emby header Host gaotao.cc:8096
	handle @emby {
		reverse_proxy 127.0.0.1:8096
	}

	@clouddrive header Host gaotao.cc:19798
	handle @clouddrive {
		reverse_proxy 127.0.0.1:19798
	}

	handle {
		respond 404
	}
}

# CloudDrive2 container-local sender. Only the webhook path is reachable on
# this authority; all other requests fail closed.
http://host.docker.internal {
	@webhook path /hooks/clouddrive2
	handle @webhook {
		route {
			request_header X-Webhook-Secret {query.key}
			request_header Content-Type application/json
			rewrite * {path}?
			reverse_proxy 127.0.0.1:3080 {
				header_up Host dsh.gaotao.cc
			}
		}
	}
	handle {
		respond 404
	}
}

http://emby.gaotao.cc {
	reverse_proxy 127.0.0.1:8096
}

http://auth.gaotao.cc {
	reverse_proxy 127.0.0.1:9091
}
